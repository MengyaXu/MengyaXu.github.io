<div class="awards-section">
  {% for award in site.data.resume.awards %}
    <div class="award-item">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div class="award-title">{{ award.title }}</div>
        <div class="award-date">{{ award.date | date: "%b %Y" }}</div>
      </div>
      
      <div class="award-awarder mb-2">
        <i class="fa-solid fa-building text-warning"></i>
        {% if award.url %}
          <a href="{{ award.url }}" target="_blank">{{ award.awarder }}</a>
        {% else %}
          {{ award.awarder }}
        {% endif %}
      </div>
      
      {% if award.summary %}
        <div class="award-summary">{{ award.summary }}</div>
      {% endif %}
    </div>
  {% endfor %}
</div>
