<div class="resume-basics">
  {% assign basics = site.data.resume.basics %}
  
  <div class="basics-name">{{ basics.name }}</div>
  <div class="basics-label">{{ basics.label }}</div>
  
  {% if basics.summary %}
    <div class="basics-summary">
      {{ basics.summary }}
    </div>
  {% endif %}
  
  <div class="contact-info mt-4">
    <div class="row text-center">
      {% if basics.email %}
        <div class="col-md-3 mb-2">
          <i class="fa-solid fa-envelope text-primary"></i>
          <br><small><a href="mailto:{{ basics.email }}">{{ basics.email }}</a></small>
        </div>
      {% endif %}
      
      {% if basics.location %}
        <div class="col-md-3 mb-2">
          <i class="fa-solid fa-location-dot text-primary"></i>
          <br><small>{{ basics.location.city }}, {{ basics.location.region }}</small>
        </div>
      {% endif %}
      
      {% if basics.url %}
        <div class="col-md-3 mb-2">
          <i class="fa-solid fa-globe text-primary"></i>
          <br><small><a href="{{ basics.url }}" target="_blank">Personal Website</a></small>
        </div>
      {% endif %}
      
      {% if basics.profiles %}
        <div class="col-md-3 mb-2">
          <i class="fa-solid fa-share-nodes text-primary"></i>
          <br>
          {% for profile in basics.profiles %}
            <small><a href="{{ profile.url }}" target="_blank">{{ profile.network }}</a></small>
            {% unless forloop.last %} • {% endunless %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
