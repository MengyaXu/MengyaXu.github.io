<div class="interests-section">
  {% for interest in site.data.resume.interests %}
    <div class="interest-category mb-4">
      {% if interest.name %}
        <h5 class="interest-name">{{ interest.name }}</h5>
      {% endif %}
      
      {% if interest.keywords and interest.keywords.size > 0 %}
        <div class="interest-keywords">
          {% for keyword in interest.keywords %}
            <span class="interest-tag">{{ keyword }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
.interests-section {
  .interest-name {
    color: var(--global-theme-color);
    font-weight: 600;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--global-theme-color);
    padding-bottom: 0.5rem;
  }
  
  .interest-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    
    .interest-tag {
      background: linear-gradient(135deg, rgba(var(--global-theme-color-rgb), 0.1) 0%, rgba(var(--global-theme-color-rgb), 0.2) 100%);
      color: var(--global-theme-color);
      padding: 0.5rem 1rem;
      border-radius: 25px;
      font-size: 0.9rem;
      border: 2px solid rgba(var(--global-theme-color-rgb), 0.3);
      transition: all 0.3s ease;
      font-weight: 500;
      
      &:hover {
        background: var(--global-theme-color);
        color: white;
        transform: scale(1.05);
        box-shadow: 0 4px 8px rgba(var(--global-theme-color-rgb), 0.3);
      }
    }
  }
}
</style>
