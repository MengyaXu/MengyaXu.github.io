<div class="education-section">
  {% for education in site.data.resume.education %}
    <div class="education-item">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <div class="studyType">{{ education.studyType }}</div>
          <div class="institution">
            {% if education.url %}
              <a href="{{ education.url }}" target="_blank">{{ education.institution }}</a>
            {% else %}
              {{ education.institution }}
            {% endif %}
          </div>
          {% if education.department %}
            <div class="department text-muted">{{ education.department }}</div>
          {% endif %}
          {% if education.location %}
            <div class="location text-muted">
              <i class="fa-solid fa-location-dot"></i> {{ education.location }}
            </div>
          {% endif %}
        </div>
        <div class="date-range">
          {{ education.startDate | date: "%b %Y" }} - {{ education.endDate | date: "%b %Y" }}
        </div>
      </div>
      
      {% if education.score %}
        <div class="score mb-2">
          <span class="badge bg-primary">{{ education.score }}</span>
        </div>
      {% endif %}
      
      {% if education.courses and education.courses.size > 0 %}
        <div class="courses">
          <strong>📚 Key Courses & Research:</strong>
          <ul class="course-list mt-2">
            {% for course in education.courses %}
              <li class="course-item">{{ course }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
.education-section {
  .course-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0.5rem;
    
    .course-item {
      background: rgba(var(--global-theme-color-rgb), 0.1);
      padding: 0.5rem;
      border-radius: 5px;
      border-left: 3px solid var(--global-theme-color);
      font-size: 0.9rem;
    }
  }
  
  .department, .location {
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }
  
  .score {
    .badge {
      font-size: 0.85rem;
      padding: 0.4rem 0.8rem;
    }
  }
}
</style>
