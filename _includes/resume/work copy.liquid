<div class="work-section">
  {% for work in site.data.resume.work %}
    <div class="work-item">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <div class="position">{{ work.position }}</div>
          <div class="company">
            {% if work.url %}
              <a href="{{ work.url }}" target="_blank">{{ work.name }}</a>
            {% else %}
              {{ work.name }}
            {% endif %}
          </div>
        </div>
        <div class="date-range">
          {{ work.startDate | date: "%b %Y" }} - 
          {% if work.endDate contains "Present" or work.endDate contains "now" %}
            Present
          {% else %}
            {{ work.endDate | date: "%b %Y" }}
          {% endif %}
        </div>
      </div>
      
      {% if work.summary %}
        <div class="summary">{{ work.summary }}</div>
      {% endif %}
      
      {% if work.highlights and work.highlights.size > 0 %}
        <div class="highlights-title mb-2">
          <strong>🎯 Key Achievements:</strong>
        </div>
        <ul class="highlights">
          {% for highlight in work.highlights %}
            <li>{{ highlight }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>
